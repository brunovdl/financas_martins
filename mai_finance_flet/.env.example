# MAI Finance — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Autenticação JWT caseiro (deve ser igual ao JWT_SECRET do Next.js atual)
JWT_SECRET=sua-chave-secreta-aqui

# Groq (assistente de IA)
GROQ_API_KEY=sua-groq-api-key-aqui

# Open Finance / Pluggy (adiado — preencher quando integração for retomada)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=

# Flet Web (porta padrão: 8550)
FLET_PORT=8550
