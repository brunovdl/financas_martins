{
  "mcpServers": {
    "flet": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "flet-cli==1.0.3",
        "--with",
        "flet-mcp==1.0.3",
        "flet",
        "mcp"
      ],
      "env": {
        "FLET_MCP_ENABLE_EXAMPLES": "1",
        "FLET_MCP_ENABLE_CLI": "1"
      }
    }
  }
}
